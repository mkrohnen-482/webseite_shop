---
import Base from '../../layouts/Base.astro';
import PersonalizeForm from '../../components/PersonalizeForm.astro';
import { getCollection, getEntry, render } from 'astro:content';
export async function getStaticPaths() {
  const products = await getCollection('products', p => p.data.active);
  return products.map(p => ({ params: { slug: p.id }, props: { p } }));
}
// Statisch: Produkt kommt aus getStaticPaths. Vorschau-Modus (Server): per Slug laden.
const p = Astro.props.p ?? await getEntry('products', Astro.params.slug!);
if (!p || !p.data.active) return new Response('Produkt nicht gefunden.', { status: 404 });
const { Content } = await render(p);
const d = p.data;
const eur = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(d.price);
---
<Base title={d.title}>
  <div class="wrap product">
    <img src={d.image} alt={d.title} width="600" height="600" />
    <div>
      <p class="technique">{d.technique}</p>
      <h1>{d.title}</h1>
      <p class="price">{eur}<br /><small>inkl. 19 % MwSt., zzgl. <a href="/versand">Versandkosten</a> · Lieferzeit {d.deliveryDays}</small></p>
      <Content />
      <PersonalizeForm slug={p.id} options={d.options} />
      {d.amazonUrl && <p><a href={d.amazonUrl} rel="noopener">Auch bei Amazon erhältlich</a></p>}
    </div>
  </div>
</Base>
<style>
  .product { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-l); align-items: start; }
  img { border-radius: var(--radius-soft); aspect-ratio: 1; object-fit: cover; background: var(--weiss); position: sticky; top: var(--space-m); }
  .technique { color: var(--grau); margin: 0; }
  .price { font-size: var(--step-2); font-weight: 600; color: var(--garnblau); }
  .price small { font-size: var(--step--1); font-weight: 400; color: var(--grau); }
</style>
